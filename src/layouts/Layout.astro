---

import ConfigCarrier from "@components/ConfigCarrier.astro";
import { profileConfig, siteConfig } from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
}

let { title, banner, description, lang, setOGTypeArticle } = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition-colors text-[14px] md:text-[16px]"
>
	<head>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle}>
		<meta name="author" content={profileConfig.name}>

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description || pageTitle}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description || pageTitle}>

		<meta name="baidu-site-verification" content="codeva-4wScbId4xe" />

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{favicons.map(favicon => (
			<link rel="icon"
			  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
			  sizes={favicon.sizes}
			  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<!-- 预加载背景图片 -->
		<link rel="preload" as="image" href="/background.webp">

		<!-- 字体：LXGW WenKai GB（正文）、Noto Serif SC（标题）、Maple Mono（代码） -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700&display=swap">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-gb-web@latest/style.css" media="print" onload="this.media='all'">
		<noscript>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700&display=swap">
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-gb-web@latest/style.css">
		</noscript>
		<style>
			@font-face {
				font-family: 'Maple Mono';
				font-style: normal;
				font-weight: 400;
				font-display: swap;
				src: url(https://cdn.jsdelivr.net/fontsource/fonts/maple-mono@latest/latin-400-normal.woff2) format('woff2');
				font-feature-settings: "cv01" 1;
			}
			@font-face {
				font-family: 'Maple Mono';
				font-style: normal;
				font-weight: 500;
				font-display: swap;
				src: url(https://cdn.jsdelivr.net/fontsource/fonts/maple-mono@latest/latin-500-normal.woff2) format('woff2');
				font-feature-settings: "cv01" 1;
			}
			@font-face {
				font-family: 'Maple Mono';
				font-style: normal;
				font-weight: 700;
				font-display: swap;
				src: url(https://cdn.jsdelivr.net/fontsource/fonts/maple-mono@latest/latin-700-normal.woff2) format('woff2');
				font-feature-settings: "cv01" 1;
			}
		</style>

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue}}>
			// Load the theme from local storage
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			// Load the hue from local storage
			const hue = localStorage.getItem('hue') || configHue;
			document.documentElement.style.setProperty('--hue', hue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);

			/*
			 * Gate the scroll-triggered entrance. The hidden state for
			 * `[data-reveal]` lives behind this class, so it must be applied
			 * before first paint or elements would flash in and then jump back
			 * to hidden.
			 *
			 * The watchdog is the safety net: if the module that drives the
			 * observer never runs (a syntax error, an old engine), the class is
			 * dropped and everything is simply visible. The reveal can fail to
			 * animate; it must never fail to show content.
			 */
			document.documentElement.classList.add('reveal-init');
			window.__revealWatchdog = window.setTimeout(() => {
				document.documentElement.classList.remove('reveal-init');
			}, 1500);
		</script>

		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->


		<slot name="head"></slot>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>

	</head>
	<body class="min-h-screen h-full transition-colors" style="overflow-y: auto !important; position: relative;"
		  class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}
	>
<!-- Global full-screen wallpaper.
     Deliberately an <img> with object-fit instead of a CSS background-image.
     A fixed element painted via `background-image` + `background-size: cover`
     has to be re-rasterised whenever that layer is recomposited, and on
     Samsung Internet the layer churn during a scroll shows up as a flicker.
     A replaced element can instead be cached as its own composited layer, so
     the texture is painted once and simply moved.

     Positioning lives entirely in styles/wallpaper.css: the markup carries no
     conflicting utilities, so there is a single source of truth for the box. -->
<div id="bg-container">
  <img id="bg-image" src="/background.webp" alt="" aria-hidden="true" draggable="false" decoding="async" fetchpriority="high" />
  <div id="bg-scrim" class="absolute inset-0 bg-black/20 dark:bg-black/40"></div>
</div>

		<ConfigCarrier></ConfigCarrier>
		<slot />

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>



		<!-- Pangu.js for Chinese text spacing -->
		<script>
			import pangu from 'pangu/browser';

			function applyPangu() {
				try {
					pangu.spacingPage();
				} catch (e) {
					console.warn('pangu.spacingPage failed:', e);
				}
			}

			applyPangu();

			if (window.swup) {
				window.swup.hooks.on('page:view', applyPangu);
			} else {
				document.addEventListener('swup:enable', () => {
					window.swup.hooks.on('page:view', applyPangu);
				});
			}
		</script>

		<!-- Ruffle Flash Emulator - 按需加载 -->
		<script>
			if (typeof window !== 'undefined') {
				// 检查页面是否包含Flash内容
				const hasFlashContent = document.querySelector('embed[type="application/x-shockwave-flash"], object[type="application/x-shockwave-flash"]');
				if (hasFlashContent) {
					// 动态加载Ruffle
					const script = document.createElement('script');
					script.src = 'https://unpkg.com/@ruffle-rs/ruffle';
					script.defer = true;
					script.async = true;
					document.body.appendChild(script);
				}
			}
		</script>

		<!-- Bad Apple Easter Egg - only fetched when the visitor actually runs
		     `badapple()` in the console. The real script (and its ~16 MB of
		     frames/audio) is never requested during normal browsing. -->
		<script>
			if (typeof window !== 'undefined') {
				let loading: Promise<void> | null = null;
				window.badapple = function () {
					if (loading) return loading;
					loading = new Promise<void>(function (resolve, reject) {
						const script = document.createElement('script');
						script.src = '/badapple/badapple.js';
						script.async = true;
						script.onload = function () {
							// the real implementation replaces window.badapple
							resolve(window.badapple());
						};
						script.onerror = reject;
						document.body.appendChild(script);
					});
					return loading;
				};
			}
		</script>
	</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
@tailwind components;
@layer components {
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--banner-height-home)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		@apply translate-y-[var(--banner-height-extend)];
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-[height] duration-300
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(1rem_-_var(--banner-height-extend))]
	}
	.navbar-hidden {
		@apply opacity-0 -translate-y-16
	}
}
</style>

<script>
import {getHue, getStoredTheme, setHue, setTheme} from "../utils/setting-utils";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_HOME,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT
} from "../constants/constants";
import { siteConfig } from '../config';
import { initReveal } from '../utils/reveal';

/* TODO This is a temporary solution for style flicker issue when the transition is activated */
/* issue link: https://github.com/withastro/astro/issues/8711, the solution get from here too */
/* update: fixed in Astro 3.2.4 */
/*
function disableAnimation() {
	const css = document.createElement('style')
	css.appendChild(
		document.createTextNode(
			`*{
			  -webkit-transition:none!important;
			  -moz-transition:none!important;
			  -o-transition:none!important;
			  -ms-transition:none!important;
			  transition:none!important
			  }`
		)
	)
	document.head.appendChild(css)

	return () => {
		// Force restyle
		;(() => window.getComputedStyle(document.body))()

		// Wait for next tick before removing
		setTimeout(() => {
			document.head.removeChild(css)
		}, 1)
	}
}
*/

const bannerEnabled = !!document.getElementById('banner-wrapper')

function setClickOutsideToClose(panel: string, ignores: string[]) {
	document.addEventListener("click", event => {
		let panelDom = document.getElementById(panel);
		let tDom = event.target;
		if (!(tDom instanceof Node)) return;
		for (let ig of ignores) {
			let ie = document.getElementById(ig)
			if (ie == tDom || (ie?.contains(tDom))) {
				return;
			}
		}
		if (panelDom) {
			panelDom.classList.add("float-panel-closed");
		}
	});
}
setClickOutsideToClose("display-setting", ["display-setting", "display-settings-switch"])
setClickOutsideToClose("nav-menu-panel", ["nav-menu-panel", "nav-menu-switch"])
setClickOutsideToClose("search-panel", ["search-panel", "search-bar", "search-switch"])


function loadTheme() {
	const theme = getStoredTheme()
	setTheme(theme)
}

function loadHue() {
	setHue(getHue())
}

function showBanner() {
	if (!siteConfig.banner.enable) return;

	const banner = document.getElementById('banner');
	if (!banner) {
		console.error('Banner element not found');
		return;
	}

	banner.classList.remove('opacity-0', 'scale-105');
}

function init() {
	// disableAnimation()()		// TODO
	loadTheme();
	loadHue();
	showBanner();
}

/* Load settings when entering the site */
init();

/*
 * Entry: the loader plays for the first visit too, exactly as it does for a
 * client-side navigation. It is started here rather than left to the markup so
 * that the overlay is only ever visible when the restore path has taken over,
 * and it is retired on the document load event. The overlay covers the first
 * paint, so the load event is also the moment the entrance stagger can start.
 */
const LOAD_BUDGET_MS = 3000;

function firstPaintBudget() {
	const nav = performance.getEntriesByType('navigation')[0];
	const ready = nav ? nav.duration : performance.now();
	return ready < LOAD_BUDGET_MS;
}

function enterWithLoader() {
	const loader = window.__akLoader;
	if (!loader) return;

	loader.start();

	const leave = () => {
		document.documentElement.classList.remove('reveal-init');
		loader.finish(firstPaintBudget);
	};

	if (document.readyState === 'complete') {
		leave();
	} else {
		window.addEventListener('load', leave, { once: true });
	}
	// Safety net: a stalled subresource must never leave the overlay covering
	// the page. Whichever fires first wins, finish() ignores the second call.
	window.setTimeout(leave, LOAD_BUDGET_MS + 400);
}

enterWithLoader();

const setup = () => {
	window.swup.hooks.on('link:click', () => {
		// Remove the delay for the first time page load
		document.documentElement.style.setProperty('--content-delay', '0ms')

		// prevent elements from overlapping the navbar
		if (!bannerEnabled) {
			return
		}
		const navThreshold = window.innerHeight * (BANNER_HEIGHT / 100) - 72 - 16
		const navbarEl = document.getElementById('navbar-wrapper')
		if (!navbarEl || !document.body.classList.contains('lg:is-home')) {
			return
		}
		if ((window.scrollY || 0) >= navThreshold) {
			navbarEl.classList.add('navbar-hidden')
		}
	})
	window.swup.hooks.on('visit:start', () => {
		// Run the Arknights-style loader for each client-side navigation
		window.__akLoader?.start()

		// Hide main content with fade out
		const mainGrid = document.getElementById('main-grid')
		if (mainGrid) {
			mainGrid.style.opacity = '0'
			mainGrid.style.transition = 'opacity 150ms ease-out'
		}

		// change banner height immediately when a link is clicked
		const bodyElement = document.querySelector('body')
		if (bodyElement) {
			const url = new URL(window.location.href)
			if (url.pathname === '/' || url.pathname === '/index.html') {
				bodyElement.classList.add('lg:is-home');
			} else {
				bodyElement.classList.remove('lg:is-home');
			}
		}

		// increase the page height during page transition to prevent the scrolling animation from jumping
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}

		// Hide the TOC while scrolling back to top
		let toc = document.getElementById('toc-wrapper');
		if (toc) {
			toc.classList.add('toc-not-ready')
		}
	});
	window.swup.hooks.on('page:view', () => {
		// Run this first, and defensively. `reveal-init` stays on <html> for the
		// life of the session, so the incoming content is hidden the moment it is
		// parsed; if this call were skipped the page would simply never appear.
		// Anything that fails here is caught and the content is shown instead.
		try {
			// The incoming containers are in the DOM now: hand the below-the-fold
			// entrances to a fresh observer. Anything already on screen is shown
			// immediately so it does not stack on top of the block rise below.
			initReveal()
		} catch {
			document.documentElement.classList.remove('reveal-init')
		}

		// Retire the loader: it holds briefly, then fades while the hairlines slide out
		window.__akLoader?.finish()

		// Show main content with progressive assembly
		const mainGrid = document.getElementById('main-grid')
		if (mainGrid) {
			mainGrid.style.opacity = '1'
			mainGrid.style.transition = 'opacity 200ms ease-in'

			// Staggered reveal, mirroring the original's 100ms cadence: each block
			// rises into place instead of a plain fade.
			//
			// These are exactly the elements that carry `.onload-animation` in the
			// markup. The class is added and deliberately left on afterwards: it
			// is what tells the stylesheet the JS entrance has taken these blocks
			// over, so their first-paint fade does not replay when this runs a
			// second time. See the `:not(.ak-rise)` guard in transition.css.
			const blocks: HTMLElement[] = [
				document.getElementById('navbar'),
				document.getElementById('sidebar'),
				document.getElementById('content-wrapper'),
				document.querySelector('.footer'),
			].filter((el): el is HTMLElement => el !== null)

			blocks.forEach((el, i) => {
				el.classList.add('ak-rise')
				el.style.setProperty('--ak-delay', `${i * 100}ms`)
				// Restart the animation on repeat visits
				el.classList.remove('ak-rise--active')
				void el.offsetWidth
				el.classList.add('ak-rise--active')
			})

			// Clean up once the longest stagger has played out. `ak-rise` stays.
			setTimeout(() => {
				blocks.forEach(el => {
					el.classList.remove('ak-rise--active')
					el.style.removeProperty('--ak-delay')
				})
			}, 900)
		}

		// hide the temp high element when the transition is done
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}
	});
	window.swup.hooks.on('visit:end', () => {
		setTimeout(() => {
			const heightExtend = document.getElementById('page-height-extend')
			if (heightExtend) {
				heightExtend.classList.add('hidden')
			}

            // Just make the transition looks better
            const tocEl = document.getElementById('toc-wrapper');
            if (tocEl) {
                tocEl.classList.remove('toc-not-ready')
            }

            // The swup container was replaced, so re-query the nodes the scroll
            // handler writes to and re-evaluate against the new page height.
            backToTopBtn = document.getElementById('back-to-top-btn')
            toc = tocEl
            navbar = document.getElementById('navbar-wrapper')
            scrollState.backToTop = null
            scrollState.toc = null
            scrollState.navbar = null
            measureScrollMetrics()
            applyScrollState()
        }, 200)
	});
}
if (window?.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup)
}

/*
 * Scroll-triggered entrance. Run once for the page that was server-rendered,
 * then again on each client-side navigation (the containers are replaced, so
 * the previous observer would be watching detached nodes).
 */
initReveal()

let backToTopBtn = document.getElementById('back-to-top-btn');
let toc = document.getElementById('toc-wrapper');
let navbar = document.getElementById('navbar-wrapper')

/*
 * Scroll handling.
 *
 * The previous version ran on every scroll event and read layout properties
 * (scrollTop/innerHeight/classList) synchronously, forcing a style+layout flush
 * several times per frame. It now:
 *   - coalesces bursts into one rAF pass, so work happens at most once a frame
 *   - caches the measured thresholds and only re-measures on resize
 *   - writes to the DOM only when a state actually flips
 */
let scrollTicking = false
let scrollTickingResize = false

// Cached measurements; recomputed on resize and on demand.
let scrollMetrics = { bannerHeight: 0, navbarThreshold: 0 }

function measureScrollMetrics() {
	const vh = window.innerHeight
	scrollMetrics.bannerHeight = vh * (BANNER_HEIGHT / 100)

	const NAVBAR_HEIGHT = 72
	// The height the main panel overlaps the banner
	const MAIN_PANEL_EXCESS_HEIGHT = MAIN_PANEL_OVERLAPS_BANNER_HEIGHT * 16

	let bannerHeight = BANNER_HEIGHT
	if (document.body.classList.contains('lg:is-home') && window.innerWidth >= 1024) {
		bannerHeight = BANNER_HEIGHT_HOME
	}
	scrollMetrics.navbarThreshold =
		vh * (bannerHeight / 100) - NAVBAR_HEIGHT - MAIN_PANEL_EXCESS_HEIGHT - 16
}

// Remember the last applied state so redundant class writes are skipped.
const scrollState = { backToTop: null as boolean | null, toc: null as boolean | null, navbar: null as boolean | null }

function applyScrollState() {
	scrollTicking = false

	// The body carries an inline `overflow-y: auto`, so depending on the layout
	// the scroller may be the body rather than the document element. Reading both
	// keeps behaviour identical to the previous implementation.
	const bodyTop = document.body.scrollTop
	const docTop = document.documentElement.scrollTop
	const top = Math.max(window.scrollY || 0, bodyTop, docTop)

	if (backToTopBtn) {
		const show = top > scrollMetrics.bannerHeight
		if (show !== scrollState.backToTop) {
			scrollState.backToTop = show
			backToTopBtn.classList.toggle('hide', !show)
		}
	}

	if (bannerEnabled && toc) {
		const show = top > scrollMetrics.bannerHeight
		if (show !== scrollState.toc) {
			scrollState.toc = show
			toc.classList.toggle('toc-hide', !show)
		}
	}

	if (bannerEnabled && navbar) {
		const hidden = top >= scrollMetrics.navbarThreshold
		if (hidden !== scrollState.navbar) {
			scrollState.navbar = hidden
			navbar.classList.toggle('navbar-hidden', hidden)
		}
	}
}

function scrollFunction() {
	if (scrollTicking) return
	scrollTicking = true
	requestAnimationFrame(applyScrollState)
}

window.addEventListener('scroll', scrollFunction, { passive: true })
// A body-level scroller does not always bubble to window, so listen there too.
document.addEventListener('scroll', scrollFunction, { passive: true, capture: true })

measureScrollMetrics()
applyScrollState()

window.addEventListener('resize', () => {
	if (scrollTickingResize) return
	scrollTickingResize = true
	requestAnimationFrame(() => {
		scrollTickingResize = false
		// keep the --banner-height-extend a multiple of 4 to avoid blurry text
		let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100))
		offset = offset - (offset % 4)
		document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`)
		measureScrollMetrics()
		// Thresholds changed, so force the next scroll pass to re-evaluate
		scrollState.navbar = null
		scrollState.toc = null
		scrollState.backToTop = null
		applyScrollState()
	})
}, { passive: true })

</script>

<script>
import "photoswipe/style.css"
import PhotoSwipeLightbox from "photoswipe/lightbox"

let lightbox: PhotoSwipeLightbox | undefined
let pswp = import("photoswipe")

function createPhotoSwipe() {
	lightbox = new PhotoSwipeLightbox({
		gallery: ".custom-md img, #post-cover img",
		pswpModule: () => pswp,
		closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11 11 28 11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
		zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
		padding: { top: 20, bottom: 20, left: 20, right: 20 },
		wheelToZoom: true,
		arrowPrev: false,
		arrowNext: false,
		imageClickAction: 'close',
		tapAction: 'close',
		doubleTapAction: 'zoom',
	})

	lightbox.addFilter("domItemData", (itemData, element) => {
		if (element instanceof HTMLImageElement) {
			itemData.src = element.src

			itemData.w = Number(element.naturalWidth || window.innerWidth)
			itemData.h = Number(element.naturalHeight || window.innerHeight)

			itemData.msrc = element.src
		}

		return itemData
	})

	lightbox.init()
}

const setupLightbox = () => {
	if (!lightbox) {
		createPhotoSwipe()
	}
	window.swup.hooks.on("page:view", () => {
		createPhotoSwipe()
	})

	window.swup.hooks.on(
		"content:replace",
		() => {
			lightbox?.destroy?.()
		},
		{ before: true },
	)
}

if (window.swup) {
	setupLightboxWhenNeeded()
} else {
	document.addEventListener("swup:enable", setupLightboxWhenNeeded)
}

function setupLightboxWhenNeeded() {
	const images = document.querySelectorAll('.custom-md img, #post-cover img');
	if (images.length === 0) {
		if (window.swup) {
			setupLightbox()
		} else {
			document.addEventListener("swup:enable", setupLightbox)
		}
		return
	}

	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				if (window.swup) {
					setupLightbox()
				} else {
					document.addEventListener("swup:enable", setupLightbox)
				}
				observer.disconnect()
			}
		})
	}, { rootMargin: '100px' })

	images.forEach(img => observer.observe(img))
}

// translate.js integration for multi-language support
// SEO-friendly: translates DOM in-place without changing URLs
(function() {
	const script = document.createElement('script');
	script.src = 'https://cdn.staticfile.net/translate.js/3.18.66/translate.js';
	script.onload = function() {
		if (typeof translate === 'undefined') return;
		
		// Use client.edge for better translation quality
		translate.service.use('client.edge');
		
		// Hide default language selector (we use custom button)
		translate.selectLanguageTag.show = false;
		
		// Set local language to Chinese (site default)
		translate.language.setLocal('chinese');
		
		// Enable dynamic content monitoring for Swup page transitions
		translate.listener.start();
		
		// Execute initial translation
		translate.execute();
		
		// Re-translate after Swup page transitions
		if (window.swup) {
			window.swup.hooks.on('content:replace', () => {
				// Give DOM a tick to settle before translating
				setTimeout(() => translate.execute(), 10);
			});
		}
	};
	document.head.appendChild(script);
})();
</script>