---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;
---
<!-- Section header, echoing the original's label + hairline device -->
<div class="card-base ak-label text-90 mb-3 px-4 py-3" data-reveal>
    <span>LATEST&nbsp;/&nbsp;最新文章</span>
</div>

<div class="transition flex flex-col rounded-[var(--radius-large)] bg-transparent gap-4 mb-4">
    {page.data.map((entry: CollectionEntry<"posts">) => (
        <PostCard
                entry={entry}
                title={entry.data.title}
                tags={entry.data.tags}
                category={entry.data.category}
                published={entry.data.published}
                updated={entry.data.updated}
                url={getPostUrlBySlug(entry.slug)}
                image={entry.data.image}
                description={entry.data.description}
                draft={entry.data.draft}
        ></PostCard>
    ))}
</div>