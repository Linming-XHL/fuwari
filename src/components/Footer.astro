                    const i = Math.floor(e % 86400 / 3600);
                    const a = Math.floor(e % 3600 / 60);
                    const r = e % 60;
                    const el = document.getElementById("runningtime");
                    if (el) {
                        el.textContent = `⭐本站已运行: ${o}天${i}小时${a}分${r}秒 ☁️`;
                    }
                }
                runtime();
                setInterval(runtime, 1000);
            }, 1000);
        }
    </script>
