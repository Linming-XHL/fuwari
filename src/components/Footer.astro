---
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
---

<!-- 页脚主体 -->
<div class="transition-colors border-dashed border-[oklch(85%_0.01_var(--hue))] dark:border-white/15 rounded-2xl py-8 mb-12 flex flex-col items-center justify-center px-6 bg-[rgba(255,255,255,0.8)] dark:bg-[rgba(17,24,39,0.8)] backdrop-blur-md">
    <div class="transition-colors text-50 text-sm text-center">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. All Rights Reserved. /
        <a class="transition-colors link text-[var(--primary)] font-medium" target="_blank" href={url('rss.xml')}>RSS</a> /
        <a class="transition-colors link text-[var(--primary)] font-medium" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a><br>
        Powered by
        <a class="transition-colors link text-[var(--primary)] font-medium" target="_blank" href="https://astro.build">Astro</a> &
        <a class="transition-colors link text-[var(--primary)] font-medium" target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a>
    </div>

    <!-- 运行时间脚本（不变） -->
    <script type="text/javascript">
        if ('requestIdleCallback' in window) {
            requestIdleCallback(function() {
                function runtime() {
                    const t = new Date("08/05/2025 08:00:00");
                    const n = new Date();
                    const s = n - t;
                    const e = Math.floor(s / 1000);
                    const o = Math.floor(e / 86400);
                    const i = Math.floor(e % 86400 / 3600);
                    const a = Math.floor(e % 3600 / 60);
                    const r = e % 60;
                    const el = document.getElementById("runningtime");
                    if (el) {
                        el.textContent = `⭐本站已运行: ${o}天${i}小时${a}分${r}秒 ☁️`;
                    }
                }
                runtime();
                setInterval(runtime, 1000);
            });
        } else {
            setTimeout(function() {
                function runtime() {
                    const t = new Date("08/05/2025 08:00:00");
                    const n = new Date();
                    const s = n - t;
                    const e = Math.floor(s / 1000);
                    const o = Math.floor(e / 86400);
                    const i = Math.floor(e % 86400 / 3600);
                    const a = Math.floor(e % 3600 / 60);
                    const r = e % 60;
                    const el = document.getElementById("runningtime");
                    if (el) {
                        el.textContent = `⭐本站已运行: ${o}天${i}小时${a}分${r}秒 ☁️`;
                    }
                }
                runtime();
                setInterval(runtime, 1000);
            }, 1000);
        }
    </script>

    <!-- 统计弹窗样式（不变） -->
    <style>
        .ef-popover-card { cursor: pointer; position: relative; }
        .ef-popover-chart-box {
            position: absolute; bottom: 100%; left: 50%; width: 280px; background: #111111; border: 1.5px solid #333333;
            padding: 8px; opacity: 0; visibility: hidden; pointer-events: none; transform: translate(-50%, -6px);
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1); z-index: 99; border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }
        .ef-popover-card:hover .ef-popover-chart-box { opacity: 1; visibility: visible; pointer-events: auto; transform: translate(-50%, -10px); }
        .ef-popover-chart-box.pop-down { top: 100%; bottom: auto; transform: translate(-50%, 6px); }
        .ef-popover-card:hover .ef-popover-chart-box.pop-down { transform: translate(-50%, 10px); }
    </style>

    <!-- 运行时间 & 访问统计 -->
    <div class="transition-colors text-50 text-sm text-center hidden md:flex items-center justify-center flex-wrap gap-2 mt-2 whitespace-nowrap">
        <span id="runningtime" class="inline-flex items-center"></span>
        <span class="opacity-40">|</span>
        <span class="ef-popover-card relative inline-flex items-center whitespace-nowrap">
            <span>本站累计访问&nbsp;</span>
            <a href="https://fakeicp.top/query.html?number=1202640" target="_blank" rel="noopener noreferrer" class="link text-[var(--primary)] font-medium inline-flex items-center whitespace-nowrap">
                <span id="flm-pv-total">0</span>次↗
            </a>
            <div class="ef-popover-chart-box">
                <div style="font-size: 8px; margin-bottom: 4px;">// 30天访问趋势折线图</div>
                <div id="flm-pv-chart"></div>
            </div>
        </span>
    </div>
    <script src="https://fakeicp.top/widget.js" data-site="zakofox.cn" data-type="popover" is:inline async></script>

    <!-- ICP 备案信息 -->
    <div class="transition-colors text-50 text-sm mt-3 flex flex-wrap justify-center items-center gap-3">
        <a href="https://icp.gov.moe/?keyword=20250341" target="_blank" rel="noopener noreferrer" 
           class="link text-[var(--primary)] font-medium">
            萌ICP备20250341号
        </a>
        <a href="https://fakeicp.top/query.html?number=1202640" target="_blank" rel="noopener noreferrer" 
           class="link text-[var(--primary)] font-medium">
            假ICP备1202640号
        </a>
    </div>
</div>
