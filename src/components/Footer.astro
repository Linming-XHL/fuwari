    <!--运行时间 -->
    <script type="text/javascript">
        if ('requestIdleCallback' in window) {
            requestIdleCallback(function() {
                function runtime() {
                    const t = new Date("08/05/2025 08:00:00");
                    const n = new Date();
                    const s = n - t;
                    const e = Math.floor(s / 1000);
                    const o = Math.floor(e / 86400);
                    const i = Math.floor(e % 86400 / 3600);
                    const a = Math.floor(e % 3600 / 60);
                    const r = e % 60;
                    const el = document.getElementById("runningtime");
                    if (el) {
                        el.textContent = `⭐本站已运行: ${o}天${i}小时${a}分${r}秒 ☁️`;
                    }
                }
                runtime();
                setInterval(runtime, 1000);
            });
        } else {
            setTimeout(function() {
                function runtime() {
                    const t = new Date("08/05/2025 08:00:00");
