---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
---
<div class="card-base p-5 text-center">
    <a aria-label="Go to About Page" href={url('/about/')}
       class="block mx-auto mb-3 w-20 rounded-full overflow-hidden ring-2 ring-[var(--primary)] ring-offset-2 ring-offset-[var(--surface)]">
        <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="w-full"></ImageWrapper>
    </a>
    <div class="font-medium text-base mb-0.5" style="color: var(--on-surface)">{config.name}</div>
    <div class="w-8 h-0.5 mx-auto rounded-full mb-2" style="background: var(--primary)"></div>
    <div class="text-sm mb-3 leading-relaxed" style="color: var(--on-surface-variant)">{config.bio}</div>
    <div class="flex flex-wrap gap-2 justify-center">
        {config.links.length > 1 && config.links.map(item =>
            <a rel="me" aria-label={item.name} href={item.url} target="_blank"
               class="w-9 h-9 flex items-center justify-center rounded-full transition-all duration-200"
               style="background: var(--surface-container); color: var(--on-surface-variant)">
                <Icon name={item.icon} class="text-[1.1rem]"></Icon>
            </a>
        )}
        {config.links.length == 1 && <a rel="me" aria-label={config.links[0].name} href={config.links[0].url} target="_blank"
                                        class="flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-full transition-all duration-200"
                                        style="background: var(--primary-container); color: var(--on-primary-container)">
            <Icon name={config.links[0].icon} class="text-[1.1rem]"></Icon>
            {config.links[0].name}
        </a>}
    </div>
</div>
