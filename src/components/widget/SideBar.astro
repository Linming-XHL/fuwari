---
import type { MarkdownHeading } from "astro";
import Advertisement from "./Advertisement.astro";
import MusicPlayer from "./MusicPlayer.svelte";
import Profile from "./Profile.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
---
<div id="sidebar" class:list={[className, "w-full self-start"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    <div id="sidebar-sticky" class="transition-[transform,opacity] duration-700 flex flex-col w-full gap-4 top-4 sticky top-4">
        <MusicPlayer client:load></MusicPlayer>
        <Advertisement></Advertisement>
    </div>
</div>
