---
import type { MarkdownHeading } from "astro";
import Advertisement from "./Advertisement.astro";
import MusicPlayer from "./MusicPlayer.svelte";
import Profile from "./Profile.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
---
<div id="sidebar" class:list={[className, "w-full self-start"]}>
    <div class="flex flex-col w-full gap-3 mb-3">
        <Profile></Profile>
    </div>
    <div id="sidebar-sticky" class="transition-[transform,opacity] duration-700 flex flex-col w-full gap-3 top-3 sticky top-3">
        <MusicPlayer client:visible></MusicPlayer>
        <Advertisement></Advertisement>
    </div>
</div>
