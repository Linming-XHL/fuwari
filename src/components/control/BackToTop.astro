---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper hidden lg:block">
    <div id="back-to-top-btn" class="back-to-top-btn hide flex items-center rounded-2xl overflow-hidden transition" onclick="backToTop()">
        <button aria-label="Back to Top" class="btn-card h-[3.75rem] w-[3.75rem]">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
        </button>
    </div>
</div>

<style lang="stylus">
.back-to-top-wrapper
    width: 3.75rem
    height: 3.75rem
    position: absolute
    right: 0
    top: 0
    pointer-events: none

.back-to-top-btn
    color: var(--primary)
    font-size: 2.25rem
    font-weight: bold
    border: none
    position: fixed
    bottom: 10rem
    opacity: 1
    cursor: pointer
    transform: translateX(5rem)
    pointer-events: auto
    i
        font-size: 1.75rem
    &.hide
        transform: translateX(5rem) scale(0.9)
        opacity: 0
        pointer-events: none
    &:active
      transform: translateX(5rem) scale(0.9)

</style>

<script is:raw is:inline>
// The <body> carries an inline `overflow-y: auto !important` (Layout.astro:204),
// so the element that actually scrolls may be the body rather than the
// viewport, and `window.scroll()` is specified to scroll the viewport only —
// clicking the button used to do nothing. Detect the scroller the same way
// Layout.astro detects the offset and drive that one, keeping the smooth
// behaviour of the original implementation.
function backToTop() {
    const options = { top: 0, left: 0, behavior: 'smooth' };
    const bodyScrolled = document.body.scrollTop !== 0;
    const docScrolled = document.documentElement.scrollTop !== 0;
    if (bodyScrolled) {
        document.body.scrollTo(options);
    }
    if (docScrolled) {
        document.documentElement.scrollTo(options);
    }
    if (!bodyScrolled && !docScrolled && (window.scrollY || 0) !== 0) {
        window.scroll(options);
    }
}
</script>
