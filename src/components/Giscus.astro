---
interface Props {
	class?: string;
}

const className = Astro.props.class || "";
---

<div class:list={["giscus-wrapper", className]} id="giscus-container">
	<div id="giscus-placeholder" class="min-h-[200px] flex items-center justify-center">
		<div class="text-neutral-400 text-sm">评论加载中...</div>
	</div>
</div>

<script>
	// The bundled <script> only executes once per full page load.
	// With Swup client-side navigation it never runs again, so we must
	// re-initialize on every 'page:view' hook instead of relying on
	// this script being re-executed.
	function cleanupGiscus() {
		document.querySelectorAll(".giscus").forEach((el) => el.remove());
		document.getElementById("giscus-script")?.remove();
	}

	function loadGiscus() {
		const placeholder = document.getElementById("giscus-placeholder");
		if (!placeholder) return;

		// remove instances left over from a previous client-side navigation
		cleanupGiscus();
		placeholder.innerHTML = "";
		const script = document.createElement("script");
		script.id = "giscus-script";
		script.src = "https://giscus.app/client.js";
		script.dataset.repo = "Linming-XHL/fuwari";
		script.dataset.repoId = "R_kgDOQ_sEMA";
		script.dataset.category = "Announcements";
		script.dataset.categoryId = "DIC_kwDOQ_sEMM4C1Wfe";
		script.dataset.mapping = "pathname";
		script.dataset.strict = "0";
		script.dataset.reactionsEnabled = "1";
		script.dataset.emitMetadata = "0";
		script.dataset.inputPosition = "top";
		script.dataset.theme = "preferred_color_scheme";
		script.dataset.lang = "zh-CN";
		script.dataset.loading = "lazy";
		script.crossOrigin = "anonymous";
		script.async = true;
		placeholder.appendChild(script);
	}

	function observeContainer() {
		const container = document.getElementById("giscus-container");
		if (!container) return;

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						loadGiscus();
						observer.disconnect();
					}
				}
			},
			{ rootMargin: "200px" },
		);
		observer.observe(container);
	}

	observeContainer();

	const setup = () => {
		window.swup.hooks.on("page:view", () => {
			cleanupGiscus();
			observeContainer();
		});
	};

	if (window?.swup?.hooks) {
		setup();
	} else {
		document.addEventListener("swup:enable", setup);
	}
</script>

<style>
	.giscus-wrapper {
		margin-top: 1.5rem;
	}

	:global(.giscus) {
		padding: 0 !important;
		background: transparent !important;
	}

	:global(.giscus-frame) {
		border: none !important;
		box-shadow: none !important;
		border-radius: var(--radius-medium);
		width: 100% !important;
		max-width: 100% !important;
	}
</style>
